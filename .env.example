# Copie este arquivo para ".env" e preencha com os dados do seu banco.
# O arquivo .env NÃO deve ir para o GitHub (ele guarda a senha).

# ---------- OPÇÃO 1: MySQL local (Workbench / XAMPP) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestao_lotes
DB_SSL=false

# ---------- OPÇÃO 2: MySQL gratuito online (Aiven) ----------
# Pegue esses dados na aba "Overview" do serviço MySQL no Aiven.
# DB_HOST=mysql-xxxxxxx-seuprojeto.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=sua_senha_do_aiven
# DB_NAME=defaultdb
# DB_SSL=true

PORTA=3000
